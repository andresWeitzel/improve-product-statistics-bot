# Copiá a .env y completá con tu Gmail + App Password
# https://myaccount.google.com/apppasswords
#
# Docker: docker-compose carga este archivo al hacer Start.
# El contenedor usa TZ=America/Argentina/Buenos_Aires → mail a las 00:00 AR.

MAIL_ENABLED=true
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_TO=tu-correo@gmail.com
MAIL_FROM=Improve Product Stats <tu-correo@gmail.com>

# facebook | mercadolibre | all
REPORT_PLATFORM=facebook
