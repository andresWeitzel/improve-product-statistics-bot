# Copiá a .env y completá.
#
# Docker local: docker-compose carga este archivo al hacer Start.
# TZ del contenedor = America/Argentina/Buenos_Aires
#
# --- Listings (URLs) — dos modos que coexisten ---
# Local (recomendado): editá los JSON en la raíz (gitignored):
#   facebook.urls.json      ← copiá desde facebook.urls.example.json
#   mercadolibre.urls.json  ← copiá desde mercadolibre.urls.example.json
#
# Render / remoto: pegá el mismo JSON en una sola línea acá (o en el panel Env):
# FACEBOOK_URLS_JSON={"Producto 1":"https://www.facebook.com/marketplace/item/.../"}
# MERCADOLIBRE_URLS_JSON={"Producto 1":"https://www.mercadolibre.com.ar/..."}
#
# Prioridad: env JSON > *.urls.json > *.urls.example.json
#
# Plataformas (opcionales):
# FACEBOOK_ENABLED=true
# MERCADOLIBRE_ENABLED=false

# --- Gmail: reporte diario + fallback de fallos ---
MAIL_ENABLED=true
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_TO=tu-correo@gmail.com
MAIL_FROM=Improve Product Stats <tu-correo@gmail.com>
# Alertas de fallo por mail (default = MAIL_ENABLED). Crítico si CallMeBot encola.
MAIL_FAIL_ENABLED=true

# Reporte diario a las REPORT_HOUR:00 (Argentina). Default 21.
REPORT_HOUR=21
REPORT_PLATFORM=facebook

# --- WhatsApp (CallMeBot) ---
# Free ≈ 16 msgs / 240 min. Si encola, NO confiamos en demora: fallback a Gmail.
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_ENABLED=true
WHATSAPP_PHONE=54911xxxxxxxx
WHATSAPP_APIKEY=tu-apikey
WHATSAPP_REPORT_ENABLED=true
WHATSAPP_FAIL_COOLDOWN_MS=900000
WHATSAPP_SEND_GAP_MS=4000
# Tras detectar cola, no insistir con WA (ms). Default 90 min.
WHATSAPP_RATE_LIMIT_COOLDOWN_MS=5400000
