# Copiá a .env y completá.
#
# Docker: docker-compose carga este archivo al hacer Start.
# TZ del contenedor = America/Argentina/Buenos_Aires

# --- Gmail: reporte diario ---
MAIL_ENABLED=true
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_TO=tu-correo@gmail.com
MAIL_FROM=Improve Product Stats <tu-correo@gmail.com>

# Reporte diario a las REPORT_HOUR:00 (Argentina). Default 21.
REPORT_HOUR=21
# facebook | mercadolibre | all
REPORT_PLATFORM=facebook

# --- WhatsApp (CallMeBot): fallos + copia del reporte diario ---
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1) Agregá el número del bot CallMeBot (ver su web)
# 2) Mandá: I allow callmebot to send me messages
# 3) Te llega el APIKEY
WHATSAPP_ENABLED=true
WHATSAPP_PHONE=54911xxxxxxxx
WHATSAPP_APIKEY=tu-apikey
# Copia del reporte diario por WA (default = WHATSAPP_ENABLED)
WHATSAPP_REPORT_ENABLED=true
# Cooldown entre alertas de fallo (ms). Default 5 min.
WHATSAPP_FAIL_COOLDOWN_MS=300000
